# Safe-by-default NameMC Sniper configuration.
# Copy this file to config.yaml. Dry runs do not contact Minecraft, Discord,
# proxies, NTP, or internet time APIs.

snipe:
  target_username: "TestName"

  # Primary account, only needed for an explicitly unlocked live claim.
  # Alternatively, leave both token fields empty and put one token per line
  # in a sibling tokens.txt file.
  bearer_token: ""

  # Add each additional account token as another YAML list item.
  bearer_tokens: []

  # Use an IANA zone matching the timezone shown by the copied NameMC time.
  # Examples: America/New_York, Europe/London, UTC, or -04:00.
  timezone_name: "America/New_York"

  # Safe mode is the default. The CLI also requires --live plus a separate
  # environment acknowledgement before it can contact a non-local claim API.
  dry_run: true
  dry_run_scenario: "taken_then_success"
  dry_run_success_after: 3
  api_base_url: "https://api.minecraftservices.com"

  start_sniping_at_seconds: 0.4
  snipe_window_seconds: 10.1
  max_snipe_attempts: 3000
  request_delay_ms: 8
  concurrent_requests: 40
  max_backoff_seconds: 5
  adaptive_delays: true
  per_token_rate_limiting: true

proxy:
  enabled: false
  proxies: []
  rotation_enabled: true
  timeout: 10
  max_retries: 3

discord:
  enabled: false
  webhook_url: ""
  mention_role_id: ""
  embed_color: 65280

notifications:
  intervals:
    - 3600
    - 1800
    - 300
    - 60
    - 30
    - 10
    - 5
    - 1

performance:
  gc_disable: true
  high_priority: true
  pre_warm_connections: true
  busy_wait_ms: 50

debug_mode: false
log_level: "INFO"
